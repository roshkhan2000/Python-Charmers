# import libraries and modules
import tableauserverclient as tsc
import pandas as pd
import numpy

# read in csv that contains server login details as a variable
login = pd.read_csv(r"G:\My Drive\03 Personal Projects\Python\Python Charmers\Day 7\tableau_server.csv")

# define server login details from the variable
# .strip() remove leading or trailing whitespace
server_url = login['server_url'][0].strip()
sitename =  login['sitename'][0].strip()
username = login['username'][0].strip()
password = login['password'][0].strip()

# set up server authentication
tableau_auth = tsc.TableauAuth(username, password, sitename)
server = tsc.Server(server_url)

# authenticate to Tableau Server
with server.auth.sign_in(tableau_auth):
    print('login successful')

    # find all site content_urls for site switching
    all_sites, pagination_item = server.sites.get()

    for site in all_sites:

        # get all groups on server
        all_groups, pagination_item = server.groups.get()
        print(site.name + " | Number of Groups: "+ str(len(all_groups))) 
    
        # loop through groups and extract group details
        for i in range(len(all_groups)):
            mygroup = all_groups[i]
            print(mygroup.name)

        server.auth.switch_site(site)
